# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key moderne (recommandee). La cle anon legacy reste acceptee en fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx
# Alternative legacy si la publishable key n'est pas encore disponible:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxx

# Cle service role (serveur uniquement, jamais exposee au client)
# Aussi utilisée pour enregistrer la newsletter et les téléchargements de guides.
SUPABASE_SERVICE_ROLE_KEY=

# Facultatif. Sel du hash d’adresse IP des inscriptions (l’IP brute n’est pas stockée).
# NEWSLETTER_IP_SALT=
# Facultatif. Secret HMAC des liens de téléchargement. À défaut, SUPABASE_SERVICE_ROLE_KEY est utilisé.
# GUIDE_DOWNLOAD_SECRET=

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxx

# IDs de prix Stripe par plan et frequence (facultatifs si mappage metadata)
STRIPE_PRICE_ESSENTIEL_MONTHLY=
STRIPE_PRICE_ESSENTIEL_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
# PRO uses the existing premium identifiers for Stripe/webhook compatibility.
# Legacy contract prices only. PRO is displayed on quote and cannot use self-service checkout.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
# Managed billing portal: only Essentiel may appear in self-service plan choices.
# Review/update with configure-pro-quote-billing.cjs; legacy PRO contracts stay intact.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# ── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Mesure d’audience et Search Console (site public uniquement) ────────────
# Laisser vide : aucun script Google Analytics et aucune balise de vérification.
# GA4 n’est chargé qu’après un identifiant valide (G-XXXXXXXX) ET le consentement
# du visiteur, et seulement sur les pages publiques. Ne pas inventer d’identifiant.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Code de la balise meta google-site-verification, pas une URL. Vide = balise absente.
# Une reconstruction du site est nécessaire après avoir renseigné la variable.
GOOGLE_SITE_VERIFICATION=

# ── Informations légales (pages publiques /mentions-legales, /confidentialite, /conditions) ──
# A renseigner UNIQUEMENT avec des informations réelles et vérifiées.
# Laisser vide = ligne masquée sur les pages (aucun placeholder "null" affiché).
# NEXT_PUBLIC_LEGAL_COMPANY_NAME=Felexia Conseils
# NEXT_PUBLIC_LEGAL_FORM=SARL
# NEXT_PUBLIC_LEGAL_CAPITAL=
# NEXT_PUBLIC_LEGAL_RC=
# NEXT_PUBLIC_LEGAL_ICE=
# NEXT_PUBLIC_LEGAL_IF=
# NEXT_PUBLIC_LEGAL_CNSS=
# NEXT_PUBLIC_LEGAL_ADDRESS=
# NEXT_PUBLIC_LEGAL_CITY=
# NEXT_PUBLIC_LEGAL_EMAIL=contact@felexia.pro
# NEXT_PUBLIC_SUPPORT_EMAIL=support@felexia.pro
# NEXT_PUBLIC_PRIVACY_EMAIL=privacy@felexia.pro
# NEXT_PUBLIC_LEGAL_PUBLISHER_NAME=
# NEXT_PUBLIC_LEGAL_WEBSITE=https://felexia.pro

# Secret serveur du cron de notifications d'essai (Bearer). Vide = cron indisponible.
CRON_SECRET=

# Secret serveur optionnel pour signer les preuves de récupération de compte.
# À défaut, la clé serveur Supabase est utilisée. Ne jamais utiliser un préfixe NEXT_PUBLIC_.
RECOVERY_SIGNING_SECRET=

# Profil léger par défaut. FELEXIA_ERP_MODE=full est ignoré : il ouvrait le menu PRO
# à toutes les sociétés alors que le SQL refuse encore leurs écritures.
# L'interface complète suit l'abonnement premium/pro, ou cette liste d'UUID.
FELEXIA_ERP_MODE=light
FELEXIA_FULL_ERP_ORGANIZATION_IDS=

# Préparation électronique locale UBL générique. Désactivée au déploiement par défaut.
# Autoriser globalement OU seulement les entreprises pilotes côté serveur.
FELEXIA_EINVOICING_ENABLED=false
FELEXIA_EINVOICING_ORGANIZATION_IDS=

# ── Assistant public Felexia ────────────────────────────────────────────────
# Le serveur vérifie le tarif nul du modèle reflection/beam-free dans le
# catalogue AI Gateway et interdit tout fournisseur/modèle payant de secours.
# Ne crée ni achat ni recharge. Si l'IA est indisponible, les fiches restent disponibles.
FELEXIA_SUPPORT_AI_FREE_CREDITS_ONLY=false
# Sur Vercel, OIDC est automatique : aucune clé à ajouter au navigateur.
# AI_GATEWAY_API_KEY=  # Serveur/local seulement, si une clé existe déjà.

# ── OCR des factures fournisseurs ───────────────────────────────────────────
# Vide : l’écran Achats affiche « OCR non configuré » et n’appelle aucun service.
# Ne pas réutiliser l’assistant public : son modèle est gratuit, textuel, et
# interdit tout fournisseur payant. Recommandé : Mistral OCR (document).
# OCR_PROVIDER=mistral
# MISTRAL_API_KEY=
# OCR_MODEL=mistral-ocr-latest
